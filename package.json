{
  "name": "ts-formal-proof",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScriptの型検査で形式証明を試す実験コード",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
